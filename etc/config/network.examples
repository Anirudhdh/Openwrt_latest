config interface                       'wanb'
       option proto                    'qmi'
       option device                   '/dev/cdc-wdm0'
       option pdptype                  'ipv4'
       option ifname                   'wwan0'
       option delay                    '30'
       option delegate                 '0'
       option modes                    'none'
       option metric                   '20'
#        option apn                    'internet.beeline.ru'
#        option auth                   'pap'
#        option username               'beeline'
#        option password               'beeline'
       option macaddr                  'random'
       option enabled                  '1'

config interface 'wg1'
        option dns                      '100.100.0.2'
