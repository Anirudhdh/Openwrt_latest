cleanup() {
echo ''
exit
}

trap "cleanup" INT

er_br() {
                echo ""
                echo "! ! ! Something went wrong. Dropping to a shell. ! ! !"
                echo ""
                echo "$*"
                exit
}

PC_LOCAL_IP='10.0.0.2'
MOTOROLA_WIFI_IP='10.0.0.4'
MOTOROLA_LTE_IP='100.100.1.4'
IPHONE_LTE_IP='100.100.1.5'
WG0TOWG1_TABLE='wg0towg1_table'

WG0TOWG1_TABLE_RULE_STATE=`(ip route show table all | grep -q "default dev wg1 table $WG0TOWG1_TABLE scope link") && (printf 'Ext') || (printf 'Not Ext')`

PC_LOCAL_IP_RULE_STATE=`(ip rule | grep -q "from $PC_LOCAL_IP lookup wg0towg1_table") && (printf 'TUNNELED TO WG1') || (printf 'DIRECT INTERNET')`
MOTOROLA_WIFI_IP_RULE_STATE=`(ip rule | grep -q "from $MOTOROLA_WIFI_IP lookup wg0towg1_table") && (printf 'TUNNELED TO WG1') || (printf 'DIRECT INTERNET')`
MOTOROLA_LTE_IP_RULE_STATE=`(ip rule | grep -q "from $MOTOROLA_LTE_IP lookup wg0towg1_table") && (printf 'TUNNELED TO WG1') || (printf 'DIRECT INTERNET')`
IPHONE_LTE_IP_RULE_STATE=`(ip rule | grep -q "from $IPHONE_LTE_IP lookup wg0towg1_table") && (printf 'TUNNELED TO WG1') || (printf 'DIRECT INTERNET')`

(nft -a list ruleset|grep -q dstnat_lan) || nft add chain inet fw4 dstnat_lan
if ! nft -a list chain inet fw4 dstnat | grep -q 'iifname "br-lan" jump dstnat_lan' ; then nft add chain inet fw4 dstnat { iifname "br-lan" jump dstnat_lan \; } ; fi
if ! nft -a list chain inet fw4 input_lan | grep -q 'ct status dnat accept' ; then nft add chain inet fw4 input_lan { ct status dnat accept \; } ; fi
if ! nft -a list chain inet fw4 forward_lan | grep -q 'ct status dnat accept' ; then nft add chain inet fw4 forward_lan { ct status dnat accept \; } ; fi

PC_LOCAL_IP_DNS_STATE=`(nft -a list chain inet fw4 dstnat_lan | grep -q "ip saddr $PC_LOCAL_IP tcp") && (printf 'DNS FWD TO WG1 DNS') || (printf 'DNSMASQ DNS SERVER')`
MOTOROLA_WIFI_IP_DNS_STATE=`(nft -a list chain inet fw4 dstnat_lan | grep -q "ip saddr $MOTOROLA_WIFI_IP tcp") && (printf 'DNS FWD TO WG1 DNS') || (printf 'DNSMASQ DNS SERVER')`
MOTOROLA_LTE_IP_DNS_STATE=`(nft -a list chain inet fw4 dstnat_lan | grep -q "ip saddr $MOTOROLA_LTE_IP tcp") && (printf 'DNS FWD TO WG1 DNS') || (printf 'DNSMASQ DNS SERVER')`
IPHONE_LTE_IP_DNS_STATE=`(nft -a list chain inet fw4 dstnat_lan | grep -q "ip saddr $IPHONE_LTE_IP tcp") && (printf 'DNS FWD TO WG1 DNS') || (printf 'DNSMASQ DNS SERVER')`

MOTOROLA_LTE_IP_RTLR_STATE=`(ip rule | grep -q "from $MOTOROLA_LTE_IP to 10.0.0.1/24 lookup main") && (printf 'ACCESS TO THE LOC: YES') || (printf 'ACCESS TO THE LOC: NO')`
IPHONE_LTE_IP_RTLR_STATE=`(ip rule | grep -q "from $IPHONE_LTE_IP to 10.0.0.1/24 lookup main") && (printf 'ACCESS TO THE LOC: YES') || (printf 'ACCESS TO THE LOC: NO')`


RESET='\033[m'
BLUE='\033[36m'
YELLOW='\033[33m'
RED='\033[31m'
BOLD=`printf '\033[1m'`
HIGHLIGHT='\e[7m'

#Low letter for VPN toggle. Big letter for full edit

show_menu() {
printf "\n${BOLD}${BLUE}**${RESET} TABLE \n"
printf "${BOLD}${BLUE}*********************************************${RESET}\n"
printf "${BOLD}${BLUE}**${RESET} ${BOLD}A)${RESET} $WG0TOWG1_TABLE  		          [ ${BOLD}$WG0TOWG1_TABLE_RULE_STATE${RESET} ]\n"

printf "\n${BOLD}${BLUE}**${RESET} RULES FOR WG1 \n"
printf "${BOLD}${BLUE}*********************************************${RESET}\n"
printf "${BOLD}${BLUE}**${RESET} ${BOLD}B)${RESET} PC 		$PC_LOCAL_IP 	  [ ${BOLD}$PC_LOCAL_IP_RULE_STATE${RESET} ] [ $PC_LOCAL_IP_DNS_STATE ]\n"
printf "${BOLD}${BLUE}**${RESET} ${BOLD}C)${RESET} MOTOROLA WIFI 	$MOTOROLA_WIFI_IP 	  [ ${BOLD}$MOTOROLA_WIFI_IP_RULE_STATE${RESET} ] [ $MOTOROLA_WIFI_IP_DNS_STATE ]\n"
printf "${BOLD}${BLUE}**${RESET} ${BOLD}D)${RESET} MOTOROLA LTE 	$MOTOROLA_LTE_IP 	  [ ${BOLD}$MOTOROLA_LTE_IP_RULE_STATE${RESET} ] [ $MOTOROLA_LTE_IP_DNS_STATE ] [ $MOTOROLA_LTE_IP_RTLR_STATE ]\n"
printf "${BOLD}${BLUE}**${RESET} ${BOLD}E)${RESET} IPHONE LTE 	$IPHONE_LTE_IP 	  [ ${BOLD}$IPHONE_LTE_IP_RULE_STATE${RESET} ] [ $IPHONE_LTE_IP_DNS_STATE ] [ $IPHONE_LTE_IP_RTLR_STATE ]\n"
printf "${BOLD}${BLUE}**${RESET} ${BOLD}F)${RESET} MOT LTE TO LOC 	to 10.0.0.1/24\n"
printf "${BOLD}${BLUE}**${RESET} ${BOLD}G)${RESET} PHO LTE TO LOC 	to 10.0.0.1/24\n"
printf "${BOLD}${BLUE}**${RESET} ${BOLD}Q)${RESET} Exit\n\n"
printf "Please enter ${BOLD}${BLUE}a toggle${RESET}:\n"
}

show_menu

while true; do
read -n 1 ans1;

case $ans1 in

       A|a)
if	[[ "$WG0TOWG1_TABLE_RULE_STATE" == "Not Ext" ]]; then
    ip route add default dev wg1 table $WG0TOWG1_TABLE scope link
elif 	[[ "$WG0TOWG1_TABLE_RULE_STATE" == "TUNNELED TO WG1" ]]; then
    ip route del default dev wg1 table $WG0TOWG1_TABLE scope link
fi

WG0TOWG1_TABLE_RULE_STATE=`(ip route show table all | grep -q "default dev wg1 table $WG0TOWG1_TABLE scope link") && (printf 'Ext') || (printf 'Not Ext')`

show_menu
        ;;
        
         B|b)
if	[[ "$PC_LOCAL_IP_RULE_STATE" == "DIRECT INTERNET" ]]; then
    ip rule add from $PC_LOCAL_IP table $WG0TOWG1_TABLE
    if ! nft -a list chain inet fw4 dstnat_lan | grep "ip saddr $PC_LOCAL_IP tcp" ; then nft add chain inet fw4 dstnat_lan { ip saddr $PC_LOCAL_IP tcp dport 53 counter packets 0 bytes 0 dnat ip to 100.100.0.2:53 \; } ; fi
    if ! nft -a list chain inet fw4 dstnat_lan | grep "ip saddr $PC_LOCAL_IP udp" ; then nft add chain inet fw4 dstnat_lan { ip saddr $PC_LOCAL_IP udp dport 53 counter packets 0 bytes 0 dnat ip to 100.100.0.2:53 \; } ; fi
elif 	[[ "$PC_LOCAL_IP_RULE_STATE" == "TUNNELED TO WG1" ]]; then
    ip rule del from $PC_LOCAL_IP table $WG0TOWG1_TABLE
    HANDLE_TCP=$(nft -a list chain inet fw4 dstnat_lan | grep "ip saddr $PC_LOCAL_IP tcp" | sed -n 's/.*handle \([0-9]*\).*/\1/p')
    HANDLE_UDP=$(nft -a list chain inet fw4 dstnat_lan | grep "ip saddr $PC_LOCAL_IP udp" | sed -n 's/.*handle \([0-9]*\).*/\1/p') 
    nft delete rule inet fw4 dstnat_lan handle $HANDLE_TCP
    nft delete rule inet fw4 dstnat_lan handle $HANDLE_UDP
fi

PC_LOCAL_IP_RULE_STATE=`(ip rule | grep -q "from $PC_LOCAL_IP lookup wg0towg1_table") && (printf 'TUNNELED TO WG1') || (printf 'DIRECT INTERNET')`
PC_LOCAL_IP_DNS_STATE=`(nft -a list chain inet fw4 dstnat_lan | grep -q "ip saddr $PC_LOCAL_IP tcp") && (printf 'DNS FWD TO WG1 DNS') || (printf 'DNSMASQ DNS SERVER')`

show_menu         
         ;;
         
         C|c)
if	[[ "$MOTOROLA_WIFI_IP_RULE_STATE" == "DIRECT INTERNET" ]]; then
    ip rule add from $MOTOROLA_WIFI_IP table $WG0TOWG1_TABLE
    if ! nft -a list chain inet fw4 dstnat_lan | grep "ip saddr $MOTOROLA_WIFI_IP tcp" ; then nft add chain inet fw4 dstnat_lan { ip saddr $MOTOROLA_WIFI_IP tcp dport 53 counter packets 0 bytes 0 dnat ip to 100.100.0.2:53 \; } ; fi
    if ! nft -a list chain inet fw4 dstnat_lan | grep "ip saddr $MOTOROLA_WIFI_IP udp" ; then nft add chain inet fw4 dstnat_lan { ip saddr $MOTOROLA_WIFI_IP udp dport 53 counter packets 0 bytes 0 dnat ip to 100.100.0.2:53 \; } ; fi
elif 	[[ "$MOTOROLA_WIFI_IP_RULE_STATE" == "TUNNELED TO WG1" ]]; then
    ip rule del from $MOTOROLA_WIFI_IP table $WG0TOWG1_TABLE
    HANDLE_TCP=$(nft -a list chain inet fw4 dstnat_lan | grep "ip saddr $MOTOROLA_WIFI_IP tcp" | sed -n 's/.*handle \([0-9]*\).*/\1/p')
    HANDLE_UDP=$(nft -a list chain inet fw4 dstnat_lan | grep "ip saddr $MOTOROLA_WIFI_IP udp" | sed -n 's/.*handle \([0-9]*\).*/\1/p') 
    nft delete rule inet fw4 dstnat_lan handle $HANDLE_TCP
    nft delete rule inet fw4 dstnat_lan handle $HANDLE_UDP
fi

MOTOROLA_WIFI_IP_RULE_STATE=`(ip rule | grep -q "from $MOTOROLA_WIFI_IP lookup wg0towg1_table") && (printf 'TUNNELED TO WG1') || (printf 'DIRECT INTERNET')`
MOTOROLA_WIFI_IP_DNS_STATE=`(nft -a list chain inet fw4 dstnat_lan | grep -q "ip saddr $MOTOROLA_WIFI_IP tcp") && (printf 'DNS FWD TO WG1 DNS') || (printf 'DNSMASQ DNS SERVER')`

show_menu         
         ;;
         
         D|d)
if	[[ "$MOTOROLA_LTE_IP_RULE_STATE" == "DIRECT INTERNET" ]]; then
    ip rule add from $MOTOROLA_LTE_IP table $WG0TOWG1_TABLE
#    nft add chain inet fw4 dstnat_lan { ip saddr $MOTOROLA_LTE_IP tcp dport 53 counter packets 0 bytes 0 dnat ip to 100.100.0.2:53 \; ip saddr $MOTOROLA_LTE_IP udp dport 53 counter packets 0 bytes 0 dnat ip to 100.100.0.2:53 \; }
elif 	[[ "$MOTOROLA_LTE_IP_RULE_STATE" == "TUNNELED TO WG1" ]]; then
    ip rule del from $MOTOROLA_LTE_IP table $WG0TOWG1_TABLE
#    HANDLE_TCP=$(nft -a list chain inet fw4 dstnat_lan | grep "ip saddr $MOTOROLA_LTE_IP tcp" | sed -n 's/.*handle \([0-9]*\).*/\1/p')
#    HANDLE_UDP=$(nft -a list chain inet fw4 dstnat_lan | grep "ip saddr $MOTOROLA_LTE_IP udp" | sed -n 's/.*handle \([0-9]*\).*/\1/p') 
#    nft delete rule inet fw4 dstnat_lan handle $HANDLE_TCP
#    nft delete rule inet fw4 dstnat_lan handle $HANDLE_UDP
fi

MOTOROLA_LTE_IP_RULE_STATE=`(ip rule | grep -q "from $MOTOROLA_LTE_IP lookup wg0towg1_table") && (printf 'TUNNELED TO WG1') || (printf 'DIRECT INTERNET')`
MOTOROLA_LTE_IP_DNS_STATE=`(nft -a list chain inet fw4 dstnat_lan | grep -q "ip saddr $MOTOROLA_LTE_IP tcp") && (printf 'DNS FWD TO WG1 DNS') || (printf 'DNSMASQ DNS SERVER')`
MOTOROLA_LTE_IP_RTLR_STATE=`(ip rule | grep -q "from $MOTOROLA_LTE_IP to 10.0.0.1/24 lookup main") && (printf 'ACCESS TO THE LOC: YES') || (printf 'ACCESS TO THE LOC: NO')`

show_menu         
         ;; 
         
         E|e)
if	[[ "$IPHONE_LTE_IP_RULE_STATE" == "DIRECT INTERNET" ]]; then
    ip rule add from $IPHONE_LTE_IP table $WG0TOWG1_TABLE
#    nft add chain inet fw4 dstnat_lan { ip saddr $IPHONE_LTE_IP tcp dport 53 counter packets 0 bytes 0 dnat ip to 100.100.0.2:53 \; ip saddr $IPHONE_LTE_IP udp dport 53 counter packets 0 bytes 0 dnat ip to 100.100.0.2:53 \; }
elif 	[[ "$IPHONE_LTE_IP_RULE_STATE" == "TUNNELED TO WG1" ]]; then
    ip rule del from $IPHONE_LTE_IP table $WG0TOWG1_TABLE
#    HANDLE_TCP=$(nft -a list chain inet fw4 dstnat_lan | grep "ip saddr $IPHONE_LTE_IP tcp" | sed -n 's/.*handle \([0-9]*\).*/\1/p')
#    HANDLE_UDP=$(nft -a list chain inet fw4 dstnat_lan | grep "ip saddr $IPHONE_LTE_IP udp" | sed -n 's/.*handle \([0-9]*\).*/\1/p') 
#    nft delete rule inet fw4 dstnat_lan handle $HANDLE_TCP
#    nft delete rule inet fw4 dstnat_lan handle $HANDLE_UDP
fi

IPHONE_LTE_IP_RULE_STATE=`(ip rule | grep -q "from $IPHONE_LTE_IP lookup wg0towg1_table") && (printf 'TUNNELED TO WG1') || (printf 'DIRECT INTERNET')`
IPHONE_LTE_IP_DNS_STATE=`(nft -a list chain inet fw4 dstnat_lan | grep -q "ip saddr $MOTOROLA_LTE_IP tcp") && (printf 'DNS FWD TO WG1 DNS') || (printf 'DNSMASQ DNS SERVER')`
IPHONE_LTE_IP_RTLR_STATE=`(ip rule | grep -q "from $IPHONE_LTE_IP to 10.0.0.1/24 lookup main") && (printf 'ACCESS TO THE LOC: YES') || (printf 'ACCESS TO THE LOC: NO')`

show_menu         
         ;;  
         
         F|f)
if	[[ "$MOTOROLA_LTE_IP_RTLR_STATE" == "ACCESS TO THE LOC: NO" ]]; then
    ip rule add from $MOTOROLA_LTE_IP to 10.0.0.1/24 lookup main
elif 	[[ "$MOTOROLA_LTE_IP_RTLR_STATE" == "ACCESS TO THE LOC: YES" ]]; then
    ip rule del from $MOTOROLA_LTE_IP to 10.0.0.1/24 lookup main
fi

MOTOROLA_LTE_IP_RTLR_STATE=`(ip rule | grep -q "from $MOTOROLA_LTE_IP to 10.0.0.1/24 lookup main") && (printf 'ACCESS TO THE LOC: YES') || (printf 'ACCESS TO THE LOC: NO')`

show_menu
        ;;
        
        G|g)
if	[[ "$IPHONE_LTE_IP_RTLR_STATE" == "ACCESS TO THE LOC: NO" ]]; then
    ip rule add from $IPHONE_LTE_IP to 10.0.0.1/24 lookup main
elif 	[[ "$IPHONE_LTE_IP_RTLR_STATE" == "ACCESS TO THE LOC: YES" ]]; then
    ip rule del from $IPHONE_LTE_IP to 10.0.0.1/24 lookup main
fi

IPHONE_LTE_IP_RTLR_STATE=`(ip rule | grep -q "from $IPHONE_LTE_IP to 10.0.0.1/24 lookup main") && (printf 'ACCESS TO THE LOC: YES') || (printf 'ACCESS TO THE LOC: NO')`

show_menu
        ;;               
         
	q|Q)
            printf "\nExiting...\n"
            break  # Exits the while loop completely
        ;;
            
        *)
            printf "\nInvalid option, try again.\n"
            continue  # Jumps back to the start of the loop (optional here, as it's the end anyway)
	;;
	
esac
done
